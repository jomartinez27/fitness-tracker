# Copy to .env.local and fill in. .env.local is gitignored — never commit a real key.

# Server-only. Required only for LIVE AI extraction; the app runs fine without it
# (the feature falls back to a deterministic local extractor). Never prefix NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5

# Feature flag for the AI extraction pillar. Off by default; see docs/adr/0003-ai-extraction-route.md
NEXT_PUBLIC_FEATURE_AI=false
